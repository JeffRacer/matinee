[ext_resource type="Script" path="res://addons/matinee/widgets/runtime_preview.gd" id="9_preview"]
[ext_resource type="Shader" path="res://addons/matinee/preview/shaders/film_burn.gdshader" id="10_burn"]

[sub_resource type="ShaderMaterial" id="ShaderMaterial_scene_burn"]
shader = ExtResource("10_burn")

[node name="DirectorDock" type="VBoxContainer"]
custom_minimum_size = Vector2(520, 720)
size_flags_vertical = 3
script = ExtResource("1_dock")

[node name="Title" type="Label" parent="."]
theme_override_font_sizes/font_size = 18
text = "DIRECTOR EDITOR"

[node name="Separator" type="HSeparator" parent="."]

[node name="SequenceSummary" type="VBoxContainer" parent="."]
script = ExtResource("2_summary")

[node name="SequenceName" type="Label" parent="SequenceSummary"]
theme_override_font_sizes/font_size = 16
autowrap_mode = 2
text = "Select a MatineeSequence resource"

[node name="SummaryGrid" type="GridContainer" parent="SequenceSummary"]
theme_override_constants/h_separation = 12
theme_override_constants/v_separation = 4
columns = 2

[node name="DurationCaption" type="Label" parent="SequenceSummary/SummaryGrid"]
text = "Length:"

[node name="DurationValue" type="Label" parent="SequenceSummary/SummaryGrid"]
size_flags_horizontal = 3
text = "—"

[node name="ActionsCaption" type="Label" parent="SequenceSummary/SummaryGrid"]
text = "Actions:"

[node name="ActionsValue" type="Label" parent="SequenceSummary/SummaryGrid"]
size_flags_horizontal = 3
text = "—"

[node name="TimingCaption" type="Label" parent="SequenceSummary/SummaryGrid"]
text = "Timing:"

[node name="TimingValue" type="Label" parent="SequenceSummary/SummaryGrid"]
size_flags_horizontal = 3
text = "—"

[node name="Toolbar" type="HBoxContainer" parent="."]
theme_override_constants/separation = 4
script = ExtResource("3_toolbar")

[node name="AddButton" type="Button" parent="Toolbar"]
tooltip_text = "Add a new action."
text = "+ Add"

[node name="AddTrackButton" type="Button" parent="Toolbar"]
tooltip_text = "Add a new timeline track."
text = "+ Track"

[node name="DuplicateButton" type="Button" parent="Toolbar"]
tooltip_text = "Duplicate the selected action."
text = "Duplicate"

[node name="DeleteButton" type="Button" parent="Toolbar"]
tooltip_text = "Delete the selected action."
text = "Delete"

[node name="MoveUpButton" type="Button" parent="Toolbar"]
tooltip_text = "Move the selected action up."
text = "▲"

[node name="MoveDownButton" type="Button" parent="Toolbar"]
tooltip_text = "Move the selected action down."
text = "▼"

[node name="TrackMenuButton" type="MenuButton" parent="Toolbar"]
tooltip_text = "Rename or change the selected track state."
text = "Track"
disabled = true

[node name="PlaybackSeparator" type="VSeparator" parent="Toolbar"]

[node name="RewindButton" type="Button" parent="Toolbar"]
tooltip_text = "Rewind to the beginning (Home)."
text = "|◀"

[node name="PlayPauseButton" type="Button" parent="Toolbar"]
custom_minimum_size = Vector2(38, 0)
tooltip_text = "Play the sequence (Space)."
text = "▶"

[node name="StopButton" type="Button" parent="Toolbar"]
tooltip_text = "Stop playback and rewind (Escape)."
text = "■"

[node name="SpeedOption" type="OptionButton" parent="Toolbar"]
custom_minimum_size = Vector2(68, 0)
tooltip_text = "Playback speed."

[node name="LoopButton" type="CheckButton" parent="Toolbar"]
tooltip_text = "Loop playback."
text = "Loop"

[node name="PreviewButton" type="CheckButton" parent="Toolbar"]
tooltip_text = "Preview supported cinematic actions in the editor."
text = "Preview"

[node name="ValidateButton" type="Button" parent="Toolbar"]
tooltip_text = "Check this sequence for missing or invalid settings."
text = "Validate"

[node name="InspectSequenceButton" type="Button" parent="Toolbar"]
size_flags_horizontal = 3
tooltip_text = "Inspect the sequence resource."
text = "Sequence"

[node name="AddMenu" type="PopupMenu" parent="."]

[node name="ActionsHeading" type="Label" parent="."]
theme_override_font_sizes/font_size = 14
text = "ACTIONS"

[node name="ActionTree" type="Tree" parent="."]
custom_minimum_size = Vector2(0, 220)
size_flags_vertical = 3
columns = 3
column_titles_visible = true
hide_root = true
select_mode = 1
drop_mode_flags = 2
script = ExtResource("4_tree")

[node name="TimelineHeading" type="Label" parent="."]
theme_override_font_sizes/font_size = 14
text = "TIMELINE"

[node name="Timeline" type="VBoxContainer" parent="."]
custom_minimum_size = Vector2(0, 220)
size_flags_vertical = 3
theme_override_constants/separation = 6
script = ExtResource("7_timeline")

[node name="TimelineToolbar" type="HBoxContainer" parent="Timeline"]
theme_override_constants/separation = 4

[node name="ZoomOutButton" type="Button" parent="Timeline/TimelineToolbar"]
tooltip_text = "Zoom out on the timeline."
text = "−"

[node name="ZoomLabel" type="Label" parent="Timeline/TimelineToolbar"]
custom_minimum_size = Vector2(68, 0)
text = "48 px/s"
vertical_alignment = 1

[node name="ZoomInButton" type="Button" parent="Timeline/TimelineToolbar"]
tooltip_text = "Zoom in on the timeline."
text = "+"

[node name="FitButton" type="Button" parent="Timeline/TimelineToolbar"]
tooltip_text = "Fit the full sequence into the visible timeline."
text = "Fit"

[node name="DebugButton" type="CheckButton" parent="Timeline/TimelineToolbar"]
tooltip_text = "Show track and clip layout diagnostics."
text = "Debug"

[node name="TrackNamesButton" type="CheckButton" parent="Timeline/TimelineToolbar"]
tooltip_text = "Expand the track name column to show long names."
text = "Wide Names"

[node name="HintLabel" type="Label" parent="Timeline/TimelineToolbar"]
size_flags_horizontal = 3
text = "Drag clips to move · Ctrl+wheel zoom · Middle-drag pan"
horizontal_alignment = 2
vertical_alignment = 1

[node name="ScrollContainer" type="ScrollContainer" parent="Timeline"]
custom_minimum_size = Vector2(0, 180)
size_flags_vertical = 3
horizontal_scroll_mode = 1
vertical_scroll_mode = 1

[node name="TimelineCanvas" type="Control" parent="Timeline/ScrollContainer"]
custom_minimum_size = Vector2(420, 180)
layout_mode = 2
mouse_filter = 1
script = ExtResource("8_timeline_canvas")

[node name="RuntimePreview" type="PanelContainer" parent="."]
visible = false
custom_minimum_size = Vector2(0, 180)
size_flags_vertical = 3
script = ExtResource("9_preview")

[node name="PreviewRoot" type="MarginContainer" parent="RuntimePreview"]
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24

[node name="Background" type="ColorRect" parent="RuntimePreview/PreviewRoot"]
