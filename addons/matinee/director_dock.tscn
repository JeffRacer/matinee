[gd_scene load_steps=12 format=3]

[ext_resource type="Script" path="res://addons/matinee/director_dock.gd" id="1_dock"]
[ext_resource type="Script" path="res://addons/matinee/widgets/sequence_summary.gd" id="2_summary"]
[ext_resource type="Script" path="res://addons/matinee/widgets/toolbar.gd" id="3_toolbar"]
[ext_resource type="Script" path="res://addons/matinee/widgets/action_tree.gd" id="4_tree"]
[ext_resource type="Script" path="res://addons/matinee/widgets/status_bar.gd" id="5_status"]
[ext_resource type="Script" path="res://addons/matinee/widgets/inspector_panel.gd" id="6_inspector"]
[ext_resource type="Script" path="res://addons/matinee/widgets/timeline.gd" id="7_timeline"]
